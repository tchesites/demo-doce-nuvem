---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import {
  negocio,
  destaques,
  combos,
  comboEspecial,
  festival,
  comoPedir,
} from '../data/negocio.js';
import boloNuvem from '../assets/fotos/bolo-nuvem.jpg';
import nuvens from '../assets/fotos/nuvens.jpg';
import combosImg from '../assets/fotos/combos.jpg';
import confeiteira from '../assets/fotos/confeiteira.png';

const imagens = { nuvens, combos: combosImg } as const;

const precoBRL = (valor: number) =>
  `R$ ${valor.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, '.')}`;
---

<BaseLayout title="Confeitaria artesanal em Canoas">
  <!-- ===== Hero ===== -->
  <section class="hero" id="topo">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="script script--dark hero__script">
          confeitaria artesanal em Canoas
        </p>

        <h1>Tão bom que parece nuvem.</h1>

        <p class="hero__lead">
          Doces, bolos e salgados feitos à mão, em porção generosa, para
          comemorar em casa.
        </p>

        <div class="hero__actions">
          <a
            class="btn btn--primary"
            href={negocio.whatsappUrl}
            target="_blank"
            rel="noopener"
          >
            <Icon name="whatsapp" size={19} />
            Pedir no WhatsApp
          </a>
          <a class="btn btn--ghost" href="#destaques">
            Ver os destaques
            <Icon name="arrow" size={17} />
          </a>
        </div>

        <p class="hero__proof">
          <Icon name="heart" size={16} />
          {negocio.seguidores} seguidores no Instagram · {negocio.cidade}/RS
        </p>
      </div>

      <figure class="hero__media">
        <Image
          src={boloNuvem}
          alt="Bolo da Nuvem, com camadas de chocolate e chantilly"
          width={620}
          height={620}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <span>Bolo da Nuvem</span>
          <strong>R$ 75</strong>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ===== Destaques ===== -->
  <section class="destaques section" id="destaques">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Destaques</p>
        <h2>O que está saindo da vitrine.</h2>
        <p>
          Receitas da casa, em porção generosa. O cardápio completo e os sabores
          do dia estão no WhatsApp.
        </p>
      </div>

      <div class="destaques__grid">
        {destaques.map((item) => (
          <article class="campaign">
            <div
              class:list={[
                'campaign__media',
                { 'campaign__media--circle': item.id === 'nuvens' },
              ]}
            >
              <Image
                src={imagens[item.id as keyof typeof imagens]}
                alt={item.alt}
                width={620}
                loading="lazy"
              />
            </div>
            <div class="campaign__body">
              <div class="campaign__top">
                <h3>{item.nome}</h3>
                <p class="campaign__price">
                  {item.precoLabel}
                  {item.detalhe && <span> {item.detalhe}</span>}
                </p>
              </div>
              <p>{item.descricao}</p>
              {item.id === 'combos' ? (
                <a class="link-arrow" href="#combos">
                  Ver os combos
                  <Icon name="arrow" size={16} />
                </a>
              ) : (
                <a
                  class="link-arrow"
                  href={negocio.whatsappUrl}
                  target="_blank"
                  rel="noopener"
                >
                  Pedir no WhatsApp
                  <Icon name="arrow" size={16} />
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Combos ===== -->
  <section class="combos section" id="combos">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Combos</p>
        <h2>Torta + salgados, do jeito que a festa pede.</h2>
        <p>
          Três tamanhos para resolver a mesa. Todos com torta de 8 fatias e
          salgadinhos fresquinhos.
        </p>
      </div>

      <ul class="combos__grid">
        {combos.map((combo) => {
          const [tag, nome] = combo.nome.split(' — ');
          return (
            <li class="combo">
              <span class="combo__tag">{tag}</span>
              <h3>{nome}</h3>
              <ul class="combo__items">
                {combo.itens.map((item) => (
                  <li>
                    <Icon name="check" size={16} />
                    {item}
                  </li>
                ))}
              </ul>
              <p class="combo__price">{precoBRL(combo.preco)}</p>
              <a
                class="btn btn--ghost combo__cta"
                href={negocio.whatsappUrl}
                target="_blank"
                rel="noopener"
              >
                Pedir este combo
              </a>
            </li>
          );
        })}
      </ul>

      <aside class="combos__special">
        <div>
          <p class="kicker combos__special-kicker">Também tem</p>
          <h3>{comboEspecial.nome}</h3>
          <p>{comboEspecial.itens.join(' · ')}</p>
        </div>
        <div class="combos__special-action">
          <strong>{precoBRL(comboEspecial.preco)}</strong>
          <a
            class="btn btn--light"
            href={negocio.whatsappUrl}
            target="_blank"
            rel="noopener"
          >
            Pedir
            <Icon name="arrow" size={16} />
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- ===== Festival ===== -->
  <section class="festival" aria-labelledby="festival-title">
    <div class="container festival__inner">
      <div class="festival__copy">
        <p class="script festival__script">festival de fatias</p>
        <h2 id="festival-title">Um pedaço grande de felicidade.</h2>
        <p>
          R$ {festival.precoFatia} a fatia. R$ {festival.precoStories} se você
          compartilhar nos stories e seguir a gente.
        </p>
        <a
          class="festival__link"
          href={negocio.instagramUrl}
          target="_blank"
          rel="noopener"
        >
          {festival.proximaData}
          <Icon name="arrow" size={16} />
        </a>
      </div>
      <div class="festival__seal" aria-hidden="true">
        <strong>R$ {festival.precoFatia}</strong>
        <span>a fatia</span>
      </div>
    </div>
  </section>

  <!-- ===== Sobre ===== -->
  <section class="sobre section" id="sobre">
    <div class="container sobre__grid">
      <figure class="sobre__media">
        <Image
          src={confeiteira}
          alt="Carla Menezes, confeiteira da Doce Nuvem, segurando um pedaço de bolo"
          width={460}
          height={460}
          loading="lazy"
        />
      </figure>

      <div class="sobre__copy">
        <p class="script">por Carla Menezes</p>
        <h2>Feito à mão, aqui no bairro.</h2>
        <p>
          A Doce Nuvem é a confeitaria da Carla, em Canoas. Doces, bolos
          e salgados feitos à mão, em porção generosa, para comemorar em casa.
        </p>
        <p>
          O cardápio muda com a festa e com a estação. O que não muda é o
          capricho: massa úmida, recheio que aparece e aquele sabor caseiro que
          faz repetir.
        </p>
        <a
          class="link-arrow"
          href={negocio.instagramUrl}
          target="_blank"
          rel="noopener"
        >
          Acompanhar no Instagram
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ===== Como pedir ===== -->
  <section class="como section" id="como-pedir">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Como pedir</p>
        <h2>Do WhatsApp para a mesa.</h2>
        <p>Sem formulário e sem complicação: você fala direto com a gente.</p>
      </div>

      <ol class="steps">
        {comoPedir.map((passo) => (
          <li class="step">
            <span class="step__num">{passo.numero}</span>
            <h3>{passo.titulo}</h3>
            <p>{passo.texto}</p>
          </li>
        ))}
      </ol>

      <div class="como__cta">
        <p>Pedidos e retirada pelo WhatsApp.</p>
        <a
          class="btn btn--primary"
          href={negocio.whatsappUrl}
          target="_blank"
          rel="noopener"
        >
          <Icon name="whatsapp" size={19} />
          Chamar a Doce Nuvem
        </a>
      </div>
    </div>
  </section>

  <!-- ===== Onde estamos ===== -->
  <section class="onde section" id="onde-estamos">
    <div class="container onde__grid">
      <div class="onde__info">
        <p class="kicker">Onde estamos</p>
        <h2>No coração do Centro.</h2>
        <address>
          {negocio.endereco}<br />
          {negocio.bairro} — {negocio.cidade}/{negocio.estado} · {negocio.cep}
        </address>
        <p class="onde__note">
          Pedidos e retirada pelo WhatsApp. Entrega a combinar.
        </p>
        <div class="onde__actions">
          <a
            class="btn btn--primary"
            href={negocio.googleMapsUrl}
            target="_blank"
            rel="noopener"
          >
            <Icon name="pin" size={18} />
            Abrir no Maps
          </a>
          <a
            class="btn btn--ghost"
            href={negocio.whatsappUrl}
            target="_blank"
            rel="noopener"
          >
            <Icon name="whatsapp" size={18} />
            Combinar pedido
          </a>
        </div>
        <a
          class="onde__instagram"
          href={negocio.instagramUrl}
          target="_blank"
          rel="noopener"
        >
          <Icon name="instagram" size={17} />
          {negocio.instagram}
        </a>
      </div>

      <div class="onde__map">
        <iframe
          src={negocio.googleMapsEmbed}
          title="Mapa da Doce Nuvem em Canoas"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== Hero ===== */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3.5rem, 8vw, 6.5rem);
    background: var(--menta);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero__script {
    margin-bottom: 1rem;
    font-size: var(--t-script);
  }

  .hero h1 {
    max-width: 12ch;
  }

  .hero__lead {
    max-width: 46ch;
    margin-top: 1.3rem;
    font-size: var(--t-lead);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .hero__proof {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.5rem;
    color: var(--chocolate-2);
    font-size: 0.83rem;
    font-weight: 700;
  }

  .hero__proof :global(svg) {
    color: var(--rosa-cta);
    flex: 0 0 auto;
  }

  .hero__media {
    margin: 0;
    padding: 0.65rem;
    border: 1px solid rgba(255, 247, 238, 0.7);
    border-radius: var(--radius-img);
    background: var(--creme);
    box-shadow: var(--shadow);
  }

  .hero__media img {
    width: 100%;
    height: auto;
    border-radius: 24px;
  }

  .hero__media figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0.45rem 0.15rem;
    color: var(--chocolate);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .hero__media figcaption strong {
    color: var(--rosa-cta);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  /* ===== Destaques ===== */
  .destaques__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 1.75rem);
  }

  .campaign {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--linha);
    border-radius: var(--radius-img);
    background: var(--creme);
  }

  .campaign__media {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    padding: 0.85rem;
    background: var(--menta-clara);
  }

  .campaign__media img {
    width: 100%;
    height: 100%;
    border-radius: 20px;
    object-fit: contain;
  }

  .campaign__media--circle img {
    width: min(100%, 24rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
  }

  .campaign__body {
    padding: 1.3rem 1.4rem 1.5rem;
    border-top: 1px solid var(--linha);
  }

  .campaign__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }

  .campaign__top h3 {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
  }

  .campaign__price {
    color: var(--rosa-cta);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .campaign__price span {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .campaign__body > p {
    margin-top: 0.65rem;
    color: var(--chocolate-2);
    font-size: 0.94rem;
  }

  .campaign__body .link-arrow {
    margin-top: 1.1rem;
    font-size: 0.85rem;
  }

  /* ===== Combos ===== */
  .combos {
    background: var(--menta-clara);
  }

  .combos__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .combo {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--linha);
    border-radius: var(--radius-card);
    background: var(--creme);
  }

  .combo__tag {
    color: var(--rosa-cta);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .combo h3 {
    margin-top: 0.35rem;
    font-size: clamp(1.35rem, 2.2vw, 1.65rem);
  }

  .combo__items {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .combo__items li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    color: var(--chocolate-2);
    font-size: 0.9rem;
  }

  .combo__items :global(svg) {
    flex: 0 0 auto;
    margin-top: 0.2rem;
    color: var(--menta-forte);
  }

  .combo__price {
    margin-top: auto;
    padding-top: 1.4rem;
    color: var(--chocolate);
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .combo__cta {
    width: 100%;
    margin-top: 1rem;
  }

  .combos__special {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.5rem;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-card);
    background: var(--chocolate);
    color: var(--creme);
  }

  .combos__special h3 {
    color: var(--creme);
    font-size: 1.5rem;
  }

  .combos__special p {
    max-width: 58ch;
    margin-top: 0.35rem;
    color: var(--rosa-claro);
    font-size: 0.88rem;
  }

  .combos__special-kicker {
    margin-bottom: 0.3rem;
    color: var(--rosa-claro);
  }

  .combos__special-kicker::before {
    background: currentColor;
  }

  .combos__special-action {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex: 0 0 auto;
  }

  .combos__special-action strong {
    color: var(--rosa-claro);
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 700;
    white-space: nowrap;
  }

  /* ===== Festival ===== */
  .festival {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    background: var(--chocolate);
    color: var(--creme);
  }

  .festival__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .festival__copy h2 {
    max-width: 14ch;
    color: var(--creme);
    font-size: clamp(2rem, 4.4vw, 3.4rem);
  }

  .festival__script {
    margin-bottom: 0.5rem;
    color: var(--rosa-claro);
  }

  .festival__copy p {
    max-width: 48ch;
    margin-top: 1rem;
    color: var(--rosa-claro);
    font-size: 1.02rem;
  }

  .festival__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.3rem;
    border-bottom: 1px solid currentColor;
    color: var(--creme);
    font-size: 0.85rem;
    font-weight: 800;
    transition: gap var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .festival__link:hover {
    gap: 0.65rem;
    color: var(--rosa-claro);
  }

  .festival__seal {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: clamp(10rem, 18vw, 13rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--rosa);
    color: var(--chocolate);
    text-align: center;
    transform: rotate(5deg);
  }

  .festival__seal::before {
    content: '';
    position: absolute;
    inset: 9px;
    border: 2px dashed rgba(61, 33, 21, 0.35);
    border-radius: 50%;
  }

  .festival__seal strong {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .festival__seal span {
    margin-top: 0.35rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ===== Sobre ===== */
  .sobre__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .sobre__media {
    justify-self: center;
    width: min(100%, 28rem);
    margin: 0;
    padding: 1.1rem;
    border-radius: 50%;
    background: var(--menta-clara);
  }

  .sobre__media img {
    width: 100%;
    height: auto;
    border-radius: 50%;
  }

  .sobre__copy h2 {
    max-width: 16ch;
    margin-top: 0.4rem;
  }

  .sobre__copy p:not(.script) {
    max-width: 58ch;
    margin-top: 1rem;
    color: var(--chocolate-2);
  }

  .sobre__copy .link-arrow {
    margin-top: 1.3rem;
    font-size: 0.88rem;
  }

  /* ===== Como pedir ===== */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--linha);
  }

  .step {
    padding: 1.8rem 1.6rem 0 0;
  }

  .step__num {
    color: var(--rosa-cta);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .step h3 {
    margin-top: 0.5rem;
    font-size: 1.25rem;
  }

  .step p {
    max-width: 32ch;
    margin-top: 0.5rem;
    color: var(--chocolate-2);
    font-size: 0.92rem;
  }

  .como__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--linha);
    border-radius: var(--radius-card);
    background: var(--creme);
  }

  .como__cta p {
    color: var(--chocolate-2);
    font-size: 0.9rem;
    font-weight: 700;
  }

  /* ===== Onde estamos ===== */
  .onde__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }

  .onde h2 {
    max-width: 14ch;
  }

  .onde address {
    margin-top: 1.3rem;
    color: var(--chocolate);
    font-size: 1.02rem;
    font-style: normal;
    line-height: 1.7;
  }

  .onde__note {
    max-width: 42ch;
    margin-top: 0.9rem;
    color: var(--chocolate-2);
    font-size: 0.95rem;
  }

  .onde__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.4rem;
  }

  .onde__instagram {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.2rem;
    color: var(--rosa-cta);
    font-size: 0.85rem;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .onde__instagram:hover {
    color: var(--chocolate);
  }

  .onde__map {
    min-height: 360px;
    overflow: hidden;
    border: 1px solid var(--linha);
    border-radius: var(--radius-card);
    background: var(--menta-clara);
  }

  .onde__map iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 360px;
    border: 0;
    filter: grayscale(0.12) saturate(0.9);
  }

  /* ===== Responsivo ===== */
  @media (max-width: 64rem) {
    .hero__grid,
    .sobre__grid,
    .onde__grid {
      grid-template-columns: 1fr;
    }

    .hero__copy {
      max-width: 42rem;
    }

