---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { negocio } from '../data/negocio.js';

const ano = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo light />
      <p>
        Confeitaria artesanal em Canoas. Doces, bolos e salgados feitos
        à mão, em porção generosa, para comemorar em casa.
      </p>
      <div class="footer__social">
        <a
          href={negocio.instagramUrl}
          target="_blank"
          rel="noopener"
          aria-label="Instagram da Doce Nuvem"
        >
          <Icon name="instagram" size={18} />
        </a>
        <a
          href={negocio.whatsappUrl}
          target="_blank"
          rel="noopener"
          aria-label="WhatsApp da Doce Nuvem"
        >
          <Icon name="whatsapp" size={18} />
        </a>
      </div>
    </div>

    <div class="footer__col">
      <h2>Cardápio</h2>
      <ul>
        <li><a href="#destaques">Destaques</a></li>
        <li><a href="#combos">Combos</a></li>
        <li><a href="#sobre">Sobre</a></li>
        <li><a href="#como-pedir">Como pedir</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h2>Contato</h2>
      <ul>
        <li>
          <a href={negocio.whatsappUrl} target="_blank" rel="noopener">
            WhatsApp
          </a>
        </li>
        <li>
          <a href={negocio.instagramUrl} target="_blank" rel="noopener">
            Instagram {negocio.instagram}
          </a>
        </li>
        <li><a href="#onde-estamos">Onde estamos</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h2>Endereço</h2>
      <address>
        {negocio.endereco}<br />
        {negocio.bairro} — {negocio.cidade}/{negocio.estado} · {negocio.cep}
      </address>
      <a
        class="footer__maps"
        href={negocio.googleMapsUrl}
        target="_blank"
        rel="noopener"
      >
        Abrir no Google Maps
        <Icon name="arrow" size={14} />
      </a>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {ano} {negocio.nome}. Feito com carinho em Canoas.</p>
    <p>
      Site por
      <a href="https://tchesites.com.br" target="_blank" rel="noopener">Tchê Sites</a>
      · Projeto demonstrativo
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    background: var(--chocolate);
    color: var(--creme);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 0.8fr 1fr 1.1fr;
    gap: 2.5rem;
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .footer__brand p {
    max-width: 32ch;
    margin-top: 1.1rem;
    color: var(--rosa-claro);
    font-size: 0.9rem;
  }

  .footer__social {
    display: flex;
    gap: 0.55rem;
    margin-top: 1.25rem;
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 247, 238, 0.25);
    border-radius: 50%;
    color: var(--creme);
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .footer__social a:hover {
    border-color: var(--rosa-claro);
    background: rgba(248, 180, 203, 0.1);
    color: var(--rosa-claro);
  }

  .footer__col h2 {
    margin-bottom: 1rem;
    color: var(--rosa-claro);
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer__col ul {
    display: grid;
    gap: 0.55rem;
    color: var(--creme);
    font-size: 0.9rem;
  }

  .footer__col a {
    transition: color var(--dur) var(--ease);
  }

  .footer__col a:hover {
    color: var(--rosa-claro);
  }

  .footer__col address {
    color: var(--creme);
    font-size: 0.9rem;
    font-style: normal;
    line-height: 1.7;
  }

  .footer__maps {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.9rem;
    color: var(--rosa-claro);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .footer__maps:hover {
    color: var(--creme);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid rgba(255, 247, 238, 0.18);
    color: var(--rosa-claro);
    font-size: 0.75rem;
  }

  .footer__bottom a {
    color: var(--creme);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer__bottom a:hover {
    color: var(--rosa-claro);
  }

  @media (max-width: 64rem) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }

    .footer__bottom {
      flex-direction: column;
    }
  }

  @media (max-width: 26rem) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
